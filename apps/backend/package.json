{
	"name": "@tiered-spending-guard/backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx src/index.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"profile:verification": "tsx scripts/profile-verification-cli.ts"
	},
	"dependencies": {
		"@fastify/swagger": "9.9.3",
		"@fastify/swagger-ui": "6.1.3",
		"@simplewebauthn/server": "14.0.3",
		"@tiered-spending-guard/security-core": "workspace:*",
		"dotenv": "18.0.10",
		"fastify": "5.12.8",
		"pino": "10.4.0",
		"viem": "2.56.7"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.16.5",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"openapi-types": "12.1.3",
		"pino-pretty": "13.2.0",
		"prettier": "3.9.9",
		"tsx": "4.19.4",
		"typescript": "5.8.3",
		"typescript-eslint": "8.71.0",
		"vitest": "4.1.10"
	}
}
