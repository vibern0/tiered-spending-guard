{
  "name": "tiered-spending-guard",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "wallet:dev": "cd packages/core && ./node_modules/.bin/hardhat compile && node ../../apps/static-wallet/scripts/artifacts.cjs && node -r ts-node/register/transpile-only scripts/static-wallet/local.cjs --wallet",
    "wallet:build": "npm --prefix apps/static-wallet run build",
    "wallet:test": "npm --prefix apps/static-wallet test",
    "build": "npm run core:build && npm run app:build && npm run landing:build && npm run wallet:build",
    "test": "npm run core:test && npm run backend:test && npm run app:test && npm run landing:test && npm run wallet:test",
    "check": "npm run core:check && npm run sdk:check && npm run backend:lint && npm run backend:format:check && npm run backend:test && npm run backend:typecheck && npm run app:test && npm run landing:test && npm run wallet:test && npm run wallet:build",
    "core:build": "npm --prefix packages/core run build",
    "security-core:build": "npm run core:build",
    "core:test": "npm --prefix packages/core test",
    "security-core:test": "npm run core:test",
    "core:test:unit": "npm --prefix packages/core run test:unit",
    "security-core:test:unit": "npm run core:test:unit",
    "core:test:integration": "npm --prefix packages/core run test:integration",
    "security-core:test:integration": "npm run core:test:integration",
    "core:check": "npm --prefix packages/core run check",
    "security-core:check": "npm run core:check",
    "core:coverage": "npm --prefix packages/core run coverage",
    "security-core:coverage": "npm run core:coverage",
    "core:slither": "npm --prefix packages/core run slither",
    "security-core:slither": "npm run core:slither",
    "core:security:check": "npm --prefix packages/core run security:check",
    "security-core:security:check": "npm run core:security:check",
    "core:plan:deployment": "npm --prefix packages/core run plan:deployment",
    "security-core:plan:deployment": "npm run core:plan:deployment",
    "core:verify:dependencies": "npm --prefix packages/core run verify:dependencies",
    "security-core:verify:dependencies": "npm run core:verify:dependencies",
    "core:verify:deployment": "npm --prefix packages/core run verify:deployment",
    "security-core:verify:deployment": "npm run core:verify:deployment",
    "core:watch:activity": "npm --prefix packages/core run watch:activity",
    "security-core:watch:activity": "npm run core:watch:activity",
    "core:rehearse": "npm --prefix packages/core run rehearse",
    "security-core:rehearse": "npm run core:rehearse",
    "core:package:sepolia-rehearsal": "npm --prefix packages/core run package:sepolia-rehearsal",
    "security-core:package:sepolia-rehearsal": "npm run core:package:sepolia-rehearsal",
    "pwa:rehearse:local": "npm --prefix packages/core run pwa:rehearse:local --",
    "backend:dev": "npm --prefix apps/backend run dev",
    "backend:lint": "npm --prefix apps/backend run lint",
    "backend:lint:fix": "npm --prefix apps/backend run lint:fix",
    "backend:format": "npm --prefix apps/backend run format",
    "backend:format:check": "npm --prefix apps/backend run format:check",
    "backend:test": "npm --prefix apps/backend test",
    "backend:typecheck": "npm --prefix apps/backend run typecheck",
    "app:dev": "npm --prefix apps/app run dev",
    "app:build": "npm --prefix apps/app run build",
    "app:preview": "npm --prefix apps/app run preview",
    "app:lint": "npm --prefix apps/app run lint",
    "app:format": "npm --prefix apps/app run format",
    "app:test": "npm --prefix apps/app test",
    "app:test:watch": "npm --prefix apps/app run test:watch",
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "landing:preview": "npm --prefix apps/landing run preview",
    "landing:lint": "npm --prefix apps/landing run lint",
    "landing:format": "npm --prefix apps/landing run format",
    "landing:test": "npm --prefix apps/landing test",
    "landing:test:watch": "npm --prefix apps/landing run test:watch",
    "sdk:check": "npm --prefix packages/sdk run check",
    "core:verify:sdk": "npm --prefix packages/core run verify:sdk"
  }
}
